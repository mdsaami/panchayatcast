# ============================================================================
# PanchayatCast — Environment Configuration Template
# Copy this file to .env and adjust values if customizing local deployment.
# No API keys are required for default execution (Open-Meteo public endpoints).
# ============================================================================

# FastAPI Backend Paths & Calibration
PANCHAYATCAST_LOCATIONS_PATH=config/locations.json
PANCHAYATCAST_MODEL_PATH=models/final_residual_model_lightgbm.joblib
PANCHAYATCAST_CONFORMAL_Q=1.15

# CORS Origins (comma-separated list of allowed origins, or * for local dev)
CORS_ORIGINS=*

# Server Binding (used when launching uvicorn via environment config)
HOST=127.0.0.1
PORT=8000

